#!/usr/bin/env bash
# ccarm — hold this session's inbox open so other sessions can reach it.
#
#   Monitor(command="ccarm <session-id>", persistent=true)
#
# Run it through the Monitor tool, not Bash: Monitor turns each stdout line into
# a notification, and that is what lets a message reach this session even while
# it sits idle waiting for its human. Under Bash it would just block forever.
#
# Why a script rather than an inline loop: the loop has three details that are
# each easy to get wrong and silent when wrong, so it lives in one place.
#   * touch first — `tail -f`/read on a missing file exits at once, leaving a
#     session that looks armed and receives nothing.
#   * drain, don't follow — starting at end-of-file skips anything queued
#     before arming, losing messages that were already accepted.
#   * move aside before decoding — a message arriving mid-drain then lands in
#     the fresh inbox and is picked up next pass, never lost or doubled.
#
# One message is one base64 line, because Monitor emits per line; decoding
# restores multi-line bodies, which Monitor re-batches into one notification.
set -u

case "${1:-}" in
  -h|--help)
    sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'
    exit 0
    ;;
  -*)
    # Without this, a stray flag becomes the "session id" and this loops
    # forever on an inbox named after it — a hang with no output.
    echo "ccarm: unknown option '$1' (expected a session id, or nothing)" >&2
    exit 2
    ;;
esac

# No argument needed: the harness exports the session's own id, so a session can
# arm itself without being told who it is. An explicit id still wins, for the
# case where one session arms an inbox on another's behalf.
SID="${1:-${CLAUDE_CODE_SESSION_ID:-}}"
if [ -z "$SID" ]; then
  echo "usage: ccarm [session-id]   (run via the Monitor tool, persistent: true)" >&2
  echo "CLAUDE_CODE_SESSION_ID is unset and no id was given." >&2
  exit 2
fi

MAILBOX="${CCREAD_MAILBOX:-$HOME/.claude/mailbox}"
INBOX="$MAILBOX/$SID.inbox"
# Proof-of-life for senders. Holding a pid and a fresh mtime lets a sender
# distinguish a real watcher from any process that merely mentions the inbox
# path — a `grep` or a `cat` would otherwise read as "armed", and a message
# sent on that evidence lands nowhere while reporting success.
HEARTBEAT="$MAILBOX/$SID.armed"

mkdir -p "$MAILBOX"
touch "$INBOX"

# RECOVER a batch stranded by a previous death (TOR-351, 2026-08-06).
# The drain below moves the whole inbox aside before delivering it, so ANY death
# between that move and the end of the loop strands the batch: gone from the inbox,
# never delivered, and — when this used mktemp — sitting in an unnamed file nobody
# would look for. SIGPIPE lands precisely there, because the write that kills the
# process IS the delivery write.
#
# Fixing it by trapping the signal cannot work: SIGKILL and a harness restart leave
# the same wreckage. So the in-flight batch has a STABLE name and is recovered on
# the next arm, which covers every death mode uniformly.
#
# Order matters: the stranded batch is OLDER than anything now in the inbox, so it
# goes first.
# The in-flight file is PER WATCHER (`.inflight.<pid>`), not per session.
#
# One shared `$SID.inflight` is a data-loss race as soon as two watchers exist for a session,
# and two watchers is a state this tool now ACTIVELY CAUSES: `--self`/`--ping` can diagnose "a
# watcher is draining into a detached consumer" and the remedy is to re-arm, which starts B
# while A is still alive. Then:
#
#   A: mv inbox -> inflight ; touch inbox        (A's batch is in the shared file)
#   B: mv inbox -> inflight                      (B OVERWRITES it with the empty one)
#   A: reads the now-empty file, rm's it         (A's batch is gone, permanently)
#
# Per-pid names remove the collision entirely rather than serialising it: two watchers cannot
# name the same file, so neither can overwrite the other's batch.
INFLIGHT="$MAILBOX/$SID.inflight.$$"

# RECOVER batches stranded by a previous death (TOR-351, 2026-08-06).
# The drain below moves the whole inbox aside before delivering it, so ANY death between that
# move and the end of the loop strands the batch: gone from the inbox and never delivered.
# SIGPIPE lands precisely there, because the write that kills the process IS the delivery write.
# Trapping the signal cannot help — SIGKILL and a harness restart leave identical wreckage — so
# recovery happens on the next arm, which covers every death mode uniformly.
#
# Recover ONLY files whose owning pid is gone. A live watcher's in-flight batch is its own and
# is mid-delivery; stealing it would recreate the loss this exists to prevent, with two
# processes reading one file.
#
# mtime in epoch seconds, portable across BSD (macOS) and GNU stat.
_mtime() { stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0; }

# ONE decoder, shared by recovery and the main loop. Two copies of "how a message becomes a
# notification" is the drift this file warns about elsewhere.
_emit_file() {
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    # `fold -s -w 400` is belt-and-braces: ccsend already wraps, but a message written straight into
    # the inbox by hand, or sent by an older ccsend, still arrives with long lines — and one stdout
    # line over ~500 chars is truncated by the notification channel with no marker at either end.
    { printf %s "$line" | base64 --decode 2>/dev/null || printf '%s' "$line"; } | fold -s -w 400
    echo
  done < "$1"
}

# RECOVERY: DRAIN each orphan in place, then delete it. Never copy it into the inbox.
#
# The previous shape staged orphans into one file, swapped it over the inbox, and only then removed
# the sources. That PUBLISHED the data while the sources were still independently recoverable, so a
# death in that window made the next watcher recover the same batch again and the recipient saw the
# message TWICE. Replacing the inbox pathname could also unlink a message a sender had just appended.
#
# Draining in place has neither problem: nothing is copied, the inbox is never replaced, and each
# file is removed only after its own contents are emitted. Delivery stays at-least-once at the
# boundary — a death mid-emit replays that one file — but a fully delivered batch can no longer be
# duplicated, and a concurrent append can no longer be destroyed.
#
# Oldest first, by mtime. Second-resolution ties are possible and are not ordered by this: two
# batches stranded within the same second may emit in either order. Ordering strictly needs a
# sequence written when the batch is created — TOR-425.
for _f in $(
  for _c in "$MAILBOX/$SID.inflight."*; do
    [ -e "$_c" ] || continue                        # the glob itself when nothing matches
    _p=${_c##*.}
    case "$_p" in (*[!0-9]*|"") continue;; esac      # not a pid suffix — leave it alone
    # An orphan bearing OUR OWN pid is ours to adopt, not to skip: `kill -0 $$` succeeds because it
    # probes this very process, so a recycled pid reads as "still owned", is skipped, and is then
    # overwritten by our first drain. Recovery runs before $INFLIGHT is written, so a file already
    # at that name necessarily belongs to a DEAD predecessor.
    if [ "$_p" != "$$" ]; then
      kill -0 "$_p" 2>/dev/null && continue          # owner alive: not ours to touch
    fi
    [ -s "$_c" ] || { rm -f "$_c"; continue; }       # empty orphan: nothing to recover
    printf '%s\t%s\n' "$(_mtime "$_c")" "$_c"
  done | sort -n | cut -f2-
); do
  _emit_file "$_f"
  rm -f "$_f"
  : > "$INBOX.recovered"            # a marker a human can find; harmless if unread
done

# The PREVIOUS release wrote ONE unsuffixed `$SID.inflight`. This version does NOT adopt it, and
# that is a decision rather than an oversight.
#
# It carries no owner identity, so the only gate available was "does the heartbeat name a live pid"
# — and that gate is unsound against exactly the release that writes this file: its trap is
# `rm -f "$HEARTBEAT"` on TERM WITHOUT exiting, so a TERM'd legacy watcher deletes its own heartbeat
# and keeps delivering. Adopting on an absent heartbeat would take a batch from a watcher still
# reading it, and the message would arrive twice.
#
# Automatic migration needs an owner id the old release does not write. So the file is left intact
# and REPORTED: recoverable by a human, and incapable of duplicating or stealing.
_legacy="$MAILBOX/$SID.inflight"
if [ -s "$_legacy" ]; then
  echo "[ccarm] NOTE: a batch from the previous release is stranded at $_legacy"
  echo "[ccarm] NOT auto-recovered - it carries no owner id, and the release that writes it can"
  echo "[ccarm] drop its heartbeat while still delivering. Recover by hand once no watcher holds"
  echo "[ccarm] this session, then delete it. See TOR-425."
fi

# A JOURNAL, so a death can be BOUNDED rather than guessed (TOR-355).
# A lane that finds itself unarmed could previously say only "it died at some
# point"; the coordinator's audit of who had missed a message could not be
# answered by anyone. START/STOP gives both ends of the window.
#
# A START with no STOP means an UNCLEAN OR UNKNOWN termination — NOT a dated
# kill. It equally describes a watcher still running and a host that rebooted.
# Do not "fix" the missing STOP lines: SIGKILL and a process-group kill are not
# trappable, and their absence is the only signal that one of those happened.
JOURNAL="$MAILBOX/$SID.journal"
printf '%s START pid=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$$" >> "$JOURNAL" 2>/dev/null || true

# On exit: record it, and DO NOT unlink the heartbeat.
#
# Unlinking looks tidier and is a race. The heartbeat is a SHARED PATHNAME with
# no ownership: on a harness restart, watcher B can publish its pid here before
# watcher A finishes its exit handler, and A's `rm` then deletes B's — leaving a
# healthy lane un-advertised until B's next refresh, which is the exact failure
# this file exists to prevent. Establishing ownership needs a generation or a
# lock; NOT deleting needs nothing.
#
# Leaving it costs nothing, because it already fails closed: `is_armed` requires
# a live pid AND a fresh mtime, so a heartbeat whose process is gone is rejected
# within one poll either way. Retaining it also PRESERVES its mtime, which is the
# only record of when the watcher was last alive.
#
# INT and TERM must EXIT. Trapping a signal replaces its default terminating
# action, so a handler that only records would return into the loop below and
# refresh the heartbeat again — `kill -TERM` would not stop this script, and the
# STOP line would be a lie told one second before the next heartbeat. Measured on
# the pre-fix version: it did not stop.
# STOP carries the pid, because START does and an unlabelled STOP cannot be paired with it.
# The comment above admits watcher B can start before A finishes exiting, so a journal can
# read `START pid=A` `START pid=B` `STOP` — and pairing that by recency marks B clean when it
# was A that stopped, while FIFO pairing is wrong in the symmetric case. Either way an audit
# bounds the wrong watcher's death, which is the one thing this journal exists to do.
_stop() { printf '%s STOP pid=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$$" >> "$JOURNAL" 2>/dev/null || true; }
trap '_stop' EXIT
trap 'exit 143' TERM
trap 'exit 130' INT

# Publish the heartbeat ATOMICALLY: write a temp file, then rename over it.
# `printf > "$HEARTBEAT"` truncates before it writes, so a reader landing in that
# window sees an empty file and calls a healthy watcher dead. A rename within one
# directory is atomic, so every reader sees either the old pid or the new one.
_beat() {
  printf %s "$$" > "$HEARTBEAT.$$.tmp" && mv -f "$HEARTBEAT.$$.tmp" "$HEARTBEAT"
}
_beat

while true; do
  if [ -s "$INBOX" ]; then
    t="$INFLIGHT"
    mv "$INBOX" "$t"
    touch "$INBOX"
    _emit_file "$t"
    rm -f "$t"
  fi
  _beat                           # refresh mtime: senders read staleness as dead
  sleep 1
done
