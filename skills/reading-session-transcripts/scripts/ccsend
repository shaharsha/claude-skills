#!/usr/bin/env python3
"""ccsend — deliver a message to another agent session on this machine.

    ccsend <id|title> "your message"
    ccsend <id|title> --file notes.md
    ccsend --list                      who can receive right now
    ccsend <id|title> --arm            print the Monitor call the target must run

A session receives only while it holds an open Monitor on its inbox. That watch
is what makes delivery work even when the session is sitting idle waiting for
its human — the one thing hooks, channels and process wrappers all fail to do.

The corollary is the reason this tool refuses by default: a session that never
armed its inbox has no watcher, so a write lands in a file nobody reads and
looks exactly like success. `ccsend` checks for the live watcher first and
refuses rather than reporting a delivery that will never happen. `--force`
queues anyway, which is only useful if you know the target will arm later.

Encoding: Monitor turns each stdout LINE into an event, so a multi-line message
would arrive as several disconnected notifications. Messages are therefore
base64'd onto a single line and decoded by the arm command; Monitor batches the
decoded lines (within 200ms) back into one notification.

Length: a notification is capped, and the cap is silent — the recipient sees a
plausible message ending mid-sentence and has no way to tell that from a sender
who stopped there. Measured 2026-07-30 by probing a live session: **~500 chars
per LINE** and **~3000 chars per EVENT**. A long technical handover is several
times that, so the tail simply vanished.

So the body is always written to a file under `<MAILBOX>/msgs/`, and only short
messages travel inline. A long one sends a preview plus that path, and says
plainly that it is a preview — an explicit pointer beats a silent cut, because
the recipient can act on the difference. Long lines are wrapped below the
per-line cap on the way out; the file keeps the text unwrapped and whole.

Replying: every delivered message carries `[reply with: ccsend <id> "..."]`.
That header exists ONLY on a delivered message — text pasted into a session by
hand is an ordinary user turn with no header, so telling a session to "reply
using the header" of a pasted prompt asks for something it cannot do. When
pasting, state your own id (`echo $CLAUDE_CODE_SESSION_ID`) in the text.
"""
import argparse
import base64
import glob
import json
import os
import re
import sys
import textwrap
import time

MAILBOX = os.path.expanduser("~/.claude/mailbox")
ROOT = os.environ.get("CCREAD_ROOT", os.path.expanduser("~/.claude/projects"))

# The receiving side lives in ccarm, not inline here. An inline copy would
# drift: the version this once printed had no heartbeat, so a session armed
# from it would have read as unarmed forever. One implementation, no drift.
CCARM = os.path.join(os.path.dirname(os.path.abspath(__file__)), "ccarm")


def sessions():
    """(session_id, title, cwd, mtime) for every transcript, newest copy first."""
    out = {}
    for f in glob.glob(os.path.join(ROOT, "*", "*.jsonl")):
        try:
            if os.path.getsize(f) < 2000:
                continue
        except OSError:
            continue
        sid = os.path.basename(f)[: -len(".jsonl")]
        title = cwd = None
        try:
            with open(f, errors="replace") as fh:
                for line in fh:
                    if not line.startswith("{"):
                        continue
                    try:
                        o = json.loads(line)
                    except ValueError:
                        continue
                    title = o.get("aiTitle") or title
                    cwd = o.get("cwd") or cwd
        except OSError:
            continue
        mt = os.path.getmtime(f)
        if sid not in out or mt > out[sid][3]:
            out[sid] = (sid, title or "(untitled)", cwd or "", mt)
    return sorted(out.values(), key=lambda s: s[3], reverse=True)


def inbox_for(sid):
    return os.path.join(MAILBOX, f"{sid}.inbox")


# Both measured on a live session, 2026-07-30, by sending a probe with position
# markers every 50 chars and reading where the notification stopped: a single
# line survived to ~500 chars, and the event as a whole to ~3000. Neither is
# documented, so treat them as observations that could move — which is exactly
# why the file copy exists rather than a cap tuned to the last byte.
LINE_CAP = 500
EVENT_CAP = 3000

# Wrap well inside the line cap, and keep the inline budget well inside the
# event cap. The header, the reply line and the preview banner all consume the
# same budget, and a message that overshoots is truncated invisibly — the one
# failure this whole mechanism exists to remove.
WRAP_AT = 400
INLINE_BUDGET = 2000

_FENCE = "```"


def wrap(text):
    """Hard-wrap to WRAP_AT so no single line can hit the per-line cap.

    Paragraph shape is worth preserving — blank lines separate ideas, and indented
    lines are usually code or a table, where a reflow does more harm than the wrap
    prevents. So indented and fenced lines are left alone unless they exceed the cap
    on their own, in which case they are split anyway: an unwrapped 900-char line
    does not arrive intact, it arrives cut at 500 with no marker.
    """
    out, fenced = [], False
    for line in text.split("\n"):
        if line.lstrip().startswith(_FENCE):
            fenced = not fenced
        protected = fenced or line[:1] in (" ", "\t") or line.lstrip().startswith("|")
        if len(line) <= WRAP_AT:
            out.append(line)
        elif protected:
            out += [line[i:i + WRAP_AT] for i in range(0, len(line), WRAP_AT)]
        else:
            out += textwrap.wrap(
                line, WRAP_AT, break_long_words=True, break_on_hyphens=False,
                replace_whitespace=False, drop_whitespace=True,
            ) or [line]
    return "\n".join(out)


def spill(sid, who, body):
    """Persist the full body and return its path.

    Every message gets a file, not just the long ones. A short message costs one
    small write, and in exchange the recipient can re-read any message after its
    notification has scrolled away or been compacted out of context — which the
    inline-only design could not offer at all.
    """
    d = os.path.join(MAILBOX, "msgs", sid)
    os.makedirs(d, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S", time.localtime())
    slug = re.sub(r"[^A-Za-z0-9]+", "-", who).strip("-").lower()[:32] or "sender"
    path = os.path.join(d, f"{stamp}-{slug}.md")
    n = 2
    while os.path.exists(path):   # same sender, same second
        path = os.path.join(d, f"{stamp}-{slug}-{n}.md")
        n += 1
    with open(path, "w") as fh:
        fh.write(body.rstrip() + "\n")
    return path


HEARTBEAT_STALE_SECONDS = 10   # ccarm refreshes every ~1s


def is_armed(sid):
    """True when a live watcher is draining this session's inbox.

    Reads ccarm's heartbeat rather than scanning the process table. A `pgrep`
    for the inbox path matches anything that merely *mentions* it — a grep, a
    cat, an editor — so an unarmed session reads as armed and the message is
    reported delivered into a void. Requiring a fresh mtime AND a live pid
    admits only a real watcher, and notices a dead one within seconds.
    """
    hb = os.path.join(MAILBOX, f"{sid}.armed")
    try:
        if time.time() - os.path.getmtime(hb) > HEARTBEAT_STALE_SECONDS:
            return False
        os.kill(int(open(hb).read().strip()), 0)   # signal 0 = liveness probe
        return True
    except Exception:
        return False


def resolve(needle, all_s):
    hits = [s for s in all_s if s[0].startswith(needle)]
    if not hits:
        n = needle.lower()
        hits = [s for s in all_s if n in s[1].lower() or n in s[2].lower()]
    if not hits:
        sys.exit(f"no session matches {needle!r} — run `ccsend --list`")
    if len({h[0] for h in hits}) > 1:
        print("ambiguous — matches:", file=sys.stderr)
        for h in hits:
            print(f"  {h[0][:8]}  {h[1]}", file=sys.stderr)
        sys.exit(1)
    return hits[0]


def main():
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("target", nargs="?")
    p.add_argument("message", nargs="*")
    p.add_argument("--file", help="read the message body from a file")
    p.add_argument("--from", dest="sender", default=os.environ.get("CCSEND_FROM", ""),
                   help="label recorded as the sender")
    p.add_argument("--list", action="store_true", help="show who can receive right now")
    p.add_argument("--arm", action="store_true", help="print the Monitor command for a target")
    p.add_argument("--force", action="store_true", help="queue even if no watcher is armed")
    p.add_argument("-h", "--help", action="store_true")
    # parse_known_args, not parse_args: argparse cannot gather a `nargs="*"`
    # positional that appears AFTER an option, and `ccsend <id> --from x "msg"`
    # is the natural way to type this. Leftovers are message text.
    a, extra = p.parse_known_args()
    a.message = list(a.message) + [x for x in extra if not x.startswith("--")]
    if a.help or (not a.target and not a.list):
        print(__doc__)
        return

    all_s = sessions()

    if a.list:
        print("armed sessions can receive now; unarmed ones cannot:\n")
        for sid, title, cwd, mt in all_s[:25]:
            idle = int((time.time() - mt) / 60)
            mark = "📬 armed  " if is_armed(sid) else "   unarmed"
            print(f"{mark} {sid[:8]}  {idle:>4}m ago  {title[:52]}")
        return

    sid, title, _cwd, _mt = resolve(a.target, all_s)
    inbox = inbox_for(sid)

    if a.arm:
        print(f"# {sid[:8]} ({title}) can receive once it runs /arm-inbox,")
        print("# or calls Monitor with persistent: true and this command:\n")
        print(f"{CCARM} {sid}")
        return

    body = open(a.file).read() if a.file else " ".join(a.message)
    if not body.strip():
        sys.exit("ccsend: empty message")

    armed = is_armed(sid)
    if not armed and not a.force:
        sys.exit(
            f"✗ not delivered — {sid[:8]} ({title}) has no inbox watcher.\n"
            f"  Nothing is listening, so this would sit unread and look like success.\n"
            f"  Have it arm one:  ccsend {sid[:8]} --arm\n"
            f"  Or queue anyway:  --force"
        )

    # Identify the sender so the recipient can reply without having to work out
    # who sent it. A message that can't be answered is a notification, not a
    # conversation — and the harness exports the caller's own id for free.
    me = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    if a.sender:
        who = a.sender
    elif me:
        mine = next((s for s in all_s if s[0] == me), None)
        who = f"{mine[1]} ({me[:8]})" if mine else me[:8]
    else:
        who = "an unidentified sender"

    os.makedirs(MAILBOX, exist_ok=True)
    body = body.rstrip()
    path = spill(sid, who, body)

    header = f"[message from {who}]"
    if me:
        header += f"\n[reply with: ccsend {me[:8]} \"...\"]"

    wrapped = wrap(body)
    if len(header) + len(wrapped) + 2 <= INLINE_BUDGET:
        payload = f"{header}\n{wrapped}"
        mode = "inline"
    else:
        # Cut on a line boundary so the preview never ends mid-sentence — the
        # exact ambiguity the cap created. The banner comes FIRST: a recipient
        # who reads only the opening lines still learns there is more, whereas a
        # footer note is the part most likely to be scrolled past.
        banner = (
            f"[PREVIEW — this message is {len(body)} chars and the notification channel "
            f"truncates near {EVENT_CAP}. Read the full text BEFORE acting on it:]\n"
            f"[{path}]"
        )
        room = INLINE_BUDGET - len(header) - len(banner) - 8
        head, total = [], 0
        for line in wrapped.split("\n"):
            if total + len(line) + 1 > room:
                break
            head.append(line)
            total += len(line) + 1
        payload = f"{header}\n{banner}\n\n" + "\n".join(head) + "\n[…]"
        mode = f"preview + file ({len(body)} chars)"

    with open(inbox, "a") as fh:
        fh.write(base64.b64encode(payload.encode()).decode() + "\n")

    where = f"{sid[:8]} ({title})"
    if armed:
        print(f"✓ delivered to {where} — a watcher is live, it arrives now [{mode}]")
    else:
        print(f"⏸ queued for {where} — NO watcher; it arrives only if one is armed [{mode}]")
    print(f"  full text: {path}")


if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        pass
