#!/usr/bin/env python3
"""ccsend — accept a message into another agent session's inbox on this machine.

    ccsend <id|title> "your message"
    ccsend <id|title> --file notes.md
    ccsend --list                      fleet inventory: who is armed (not who will receive)
    ccsend <id|title> --arm            print the Monitor call the target must run

A session picks messages up only while it holds an open Monitor on its inbox.
That watch is what lets a message be picked up even when the session is idle
waiting for its human — the one thing hooks, channels and process wrappers all
fail to do. Holding a lease is NOT the same as receiving: a watcher whose
Monitor consumer has detached keeps its lease fresh AND drains the inbox, so
the message is consumed and nobody sees it (TOR-425, detached-watcher drain).

The corollary is the reason this tool refuses by default: a session that never
armed its inbox has no watcher, so a write lands in a file nobody reads and
looks exactly like success. `ccsend` checks for the live watcher first and
refuses rather than reporting a delivery that will never happen. `--force`
queues anyway, which is only useful if you know the target will arm later.

Encoding: Monitor turns each stdout LINE into an event, so a multi-line message
would arrive as several disconnected notifications. Messages are therefore
base64'd onto a single line and decoded by the arm command; Monitor batches the
decoded lines (within 200ms) back into one notification.

Length: a notification is capped, and the cap is silent — the recipient sees a
plausible message ending mid-sentence and has no way to tell that from a sender
who stopped there. Measured 2026-07-30 by probing a live session: **~500 chars
per LINE** and **~3000 chars per EVENT**. A long technical handover is several
times that, so the tail simply vanished.

So the body is always written to a file under `<MAILBOX>/msgs/`, and only short
messages travel inline. A long one sends a preview plus that path, and says
plainly that it is a preview — an explicit pointer beats a silent cut, because
the recipient can act on the difference. Long lines are wrapped below the
per-line cap on the way out; the file keeps the text unwrapped and whole.

Replying: every delivered message carries `[reply with: ccsend <id> "..."]`.
That header exists ONLY on a delivered message — text pasted into a session by
hand is an ordinary user turn with no header, so telling a session to "reply
using the header" of a pasted prompt asks for something it cannot do. When
pasting, state your own id (`echo $CLAUDE_CODE_SESSION_ID`) in the text.
"""
import argparse
import base64
import glob
import json
import os
import re
import sys
import textwrap
import time

# Honour CCREAD_MAILBOX exactly as ccarm does (`${CCREAD_MAILBOX:-$HOME/.claude/mailbox}`).
# This was hardcoded, and ccarm was not: a watcher armed with the override wrote its heartbeat
# somewhere ccsend never looked, so every check here reported a perfectly healthy lane as unarmed.
# It also made isolated testing impossible — a probe mailbox could not be pointed at.
MAILBOX = os.environ.get("CCREAD_MAILBOX") or os.path.expanduser("~/.claude/mailbox")
ROOT = os.environ.get("CCREAD_ROOT", os.path.expanduser("~/.claude/projects"))

# The receiving side lives in ccarm, not inline here. An inline copy would
# drift: the version this once printed had no heartbeat, so a session armed
# from it would have read as unarmed forever. One implementation, no drift.
CCARM = os.path.join(os.path.dirname(os.path.abspath(__file__)), "ccarm")


def sessions():
    """(session_id, title, cwd, mtime) for every transcript, newest copy first."""
    out = {}
    for f in glob.glob(os.path.join(ROOT, "*", "*.jsonl")):
        try:
            if os.path.getsize(f) < 2000:
                continue
        except OSError:
            continue
        sid = os.path.basename(f)[: -len(".jsonl")]
        custom_title = ai_title = cwd = None
        try:
            with open(f, errors="replace") as fh:
                for line in fh:
                    if not line.startswith("{"):
                        continue
                    try:
                        o = json.loads(line)
                    except ValueError:
                        continue
                    # `customTitle` (a human renamed this session) beats `aiTitle` (generated from
                    # the first message). The human-set name is what the picker shows and what they
                    # will say out loud — and here it also decides DELIVERY, since `resolve()` below
                    # matches the target against this string. Matching only ai-titles means
                    # `ccsend "TOR-214"` finds nothing while the user is looking straight at a lane
                    # named exactly that. Last of each wins; a session can be renamed repeatedly.
                    custom_title = o.get("customTitle") or custom_title
                    ai_title = o.get("aiTitle") or ai_title
                    cwd = o.get("cwd") or cwd
        except OSError:
            continue
        mt = os.path.getmtime(f)
        title = custom_title or ai_title or "(untitled)"
        prev = out.get(sid)
        # Inherit a human-set name from an older copy: a rename lands in whichever file was live at
        # the time, so a session renamed BEFORE it moved worktrees carries its real name only there.
        if prev is not None and not custom_title and prev[4]:
            title, custom_title = prev[1], True
        if prev is None or mt > prev[3]:
            out[sid] = (sid, title, cwd or "", mt, bool(custom_title), ai_title or "")
        elif custom_title and not prev[4]:
            out[sid] = (prev[0], title, prev[2], prev[3], True, prev[5])
    return sorted(out.values(), key=lambda s: s[3], reverse=True)


def inbox_for(sid):
    return os.path.join(MAILBOX, f"{sid}.inbox")


# Both measured on a live session, 2026-07-30, by sending a probe with position
# markers every 50 chars and reading where the notification stopped: a single
# line survived to ~500 chars, and the event as a whole to ~3000. Neither is
# documented, so treat them as observations that could move — which is exactly
# why the file copy exists rather than a cap tuned to the last byte.
LINE_CAP = 500
EVENT_CAP = 3000

# Wrap well inside the line cap, and keep the inline budget well inside the
# event cap. The header, the reply line and the preview banner all consume the
# same budget, and a message that overshoots is truncated invisibly — the one
# failure this whole mechanism exists to remove.
WRAP_AT = 400
INLINE_BUDGET = 2000

# Spooled bodies are a convenience for re-reading, not an archive — the durable
# record of what a session was told is its own transcript, which ccread reads.
SPOOL_RETENTION_DAYS = 14

_FENCE = "```"


def wrap(text):
    """Hard-wrap to WRAP_AT so no single line can hit the per-line cap.

    Paragraph shape is worth preserving — blank lines separate ideas, and indented
    lines are usually code or a table, where a reflow does more harm than the wrap
    prevents. So indented and fenced lines are left alone unless they exceed the cap
    on their own, in which case they are split anyway: an unwrapped 900-char line
    does not arrive intact, it arrives cut at 500 with no marker.
    """
    out, fenced = [], False
    for line in text.split("\n"):
        if line.lstrip().startswith(_FENCE):
            fenced = not fenced
        protected = fenced or line[:1] in (" ", "\t") or line.lstrip().startswith("|")
        if len(line) <= WRAP_AT:
            out.append(line)
        elif protected:
            out += [line[i:i + WRAP_AT] for i in range(0, len(line), WRAP_AT)]
        else:
            out += textwrap.wrap(
                line, WRAP_AT, break_long_words=True, break_on_hyphens=False,
                replace_whitespace=False, drop_whitespace=True,
            ) or [line]
    return "\n".join(out)


def spill(sid, who, body):
    """Persist the full body and return its path.

    Every message gets a file, not just the long ones. A short message costs one
    small write, and in exchange the recipient can re-read any message after its
    notification has scrolled away or been compacted out of context — which the
    inline-only design could not offer at all.
    """
    d = os.path.join(MAILBOX, "msgs", sid)
    os.makedirs(d, exist_ok=True)
    stamp = time.strftime("%Y%m%d-%H%M%S", time.localtime())
    slug = re.sub(r"[^A-Za-z0-9]+", "-", who).strip("-").lower()[:32] or "sender"
    path = os.path.join(d, f"{stamp}-{slug}.md")
    n = 2
    while os.path.exists(path):   # same sender, same second
        path = os.path.join(d, f"{stamp}-{slug}-{n}.md")
        n += 1
    with open(path, "w") as fh:
        fh.write(body.rstrip() + "\n")

    # Prune on write rather than on a timer — there is no daemon to hang one on,
    # and an inbox spool that grows forever is a slow leak in a directory nobody
    # thinks to look at. A message older than the retention window has long since
    # been read or forgotten; the notification it belonged to is far out of context.
    cutoff = time.time() - SPOOL_RETENTION_DAYS * 86400
    for old in os.listdir(d):
        p = os.path.join(d, old)
        try:
            if p != path and os.path.getmtime(p) < cutoff:
                os.remove(p)
        except OSError:
            pass          # a concurrent reader or another sender; not worth failing a send
    return path


HEARTBEAT_STALE_SECONDS = 10   # ccarm refreshes every ~1s


def is_armed(sid):
    """True when a live watcher is draining this session's inbox.

    Reads ccarm's heartbeat rather than scanning the process table. A `pgrep`
    for the inbox path matches anything that merely *mentions* it — a grep, a
    cat, an editor — so an unarmed session reads as armed and the message is
    reported delivered into a void. Requiring a fresh mtime AND a live pid
    admits only a real watcher, and notices a dead one within seconds.
    """
    hb = os.path.join(MAILBOX, f"{sid}.armed")
    try:
        if time.time() - os.path.getmtime(hb) > HEARTBEAT_STALE_SECONDS:
            return False
        os.kill(int(open(hb).read().strip()), 0)   # signal 0 = liveness probe
        return True
    except Exception:
        return False


def self_check(me):
    """THIS session's own watcher lease. Exit 0 fresh, 1 none, 3 cannot tell.

    Why this exists: from inside a session, a dead inbox and a quiet sprint are the SAME
    observation — silence. "I received a message recently" is consistent with a live inbox and
    with one that delivered that message and then died. So the check has to be a POSITIVE
    signal, non-empty when healthy, and re-runnable at any moment.

    Why it does NOT say "watcher live". The evidence is a fresh mtime plus `kill(pid, 0)`, and
    a PID CAN BE REUSED: a watcher killed just after a refresh, whose pid is recycled inside
    the 10s window, makes that probe succeed for an unrelated process. So the success wording
    is what the evidence actually supports — a fresh lease naming a pid that currently exists.
    Binding a process-start identity would close it; that is deliberately not in this change,
    and overclaiming here would be the defect this ticket is about.

    Why THREE states. "I could not tell" is not "you have no watcher": as 0 it certifies an
    unmeasured check, as 1 it reports a defect nobody observed. `is_armed()` collapses both
    into False on purpose — every send path must fail closed — so the distinction lives here.
    """
    if not me:
        print("CANNOT TELL — CLAUDE_CODE_SESSION_ID is unset, so there is no 'self' to check")
        return 3
    hb = os.path.join(MAILBOX, f"{me}.armed")
    # ONE open, then fstat + read from that SAME descriptor. Reading mtime by pathname and the
    # pid by a second open samples two different generations: ccarm republishes by atomic
    # rename, so a healthy watcher that publishes between the two calls yields the NEW pid with
    # the OLD mtime — reported as NO LEASE for a watcher that is fine.
    try:
        fh = open(hb)
    except FileNotFoundError:
        print(f"NO LEASE — no heartbeat file for {me[:8]}. Nothing is draining your inbox.")
        print("  Re-arm: Monitor(command=ccarm, persistent=true). SAFE here — no watcher exists,")
        print("  so arming cannot put you behind a second one. Messages sent meanwhile were REFUSED,")
        print("  so the senders know; you were not silently skipped.")
        return 1
    except OSError as e:
        print(f"CANNOT TELL — cannot open {hb}: {e}")
        return 3
    try:
        with fh:
            age = time.time() - os.fstat(fh.fileno()).st_mtime
            pid = int(fh.read().strip())
    except (OSError, ValueError) as e:
        print(f"CANNOT TELL — heartbeat for {me[:8]} is unreadable or malformed: {e}")
        return 3
    try:
        os.kill(pid, 0)
    except OverflowError:
        # A heartbeat holding a number too large for a pid_t raises OverflowError, not
        # ProcessLookupError — so an unguarded probe replaced the three-state verdict with a
        # traceback, in the check whose entire contract is that it always answers 0, 1 or 3.
        print(f"CANNOT TELL — heartbeat for {me[:8]} names {pid}, which is not a usable pid")
        return 3
    except ProcessLookupError:
        print(f"NO LEASE — watcher pid {pid} is gone; last heartbeat {age:.0f}s ago.")
        print("  Re-arm: SAFE here — the owning process is gone, so arming creates no second watcher.")
        print(f"  Journal: {os.path.join(MAILBOX, me + '.journal')} — a START with no STOP means an")
        print("  unclean OR UNKNOWN termination. SIGKILL and a harness restart cannot be trapped —")
        print("  and the journal append is best-effort, so a clean exit whose STOP could not be")
        print("  written is indistinguishable from an untrappable death.")
        return 1
    except PermissionError:
        print(f"CANNOT TELL — pid {pid} exists but is not ours to probe (age {age:.0f}s)")
        return 3
    except OSError as e:
        print(f"CANNOT TELL — probing pid {pid} failed: {e}")
        return 3
    if age > HEARTBEAT_STALE_SECONDS:
        print(f"NO LEASE — heartbeat is {age:.0f}s stale (limit {HEARTBEAT_STALE_SECONDS}s); "
              f"pid {pid} exists but is not refreshing it.")
        # The ONE branch where re-arming is not obviously right: a process is there and wedged.
        # Arming now leaves TWO watchers racing for the inbox, and the wedged one can still win a
        # message and emit it where nobody reads (TOR-425 §2, open). The other two branches have no
        # live process, so arming cannot create that state — which is why the advice differs by
        # branch rather than being printed uniformly.
        # Do NOT tell anyone to kill this pid. The same reuse caveat this function already states
        # for FRESH LEASE applies here: `kill(pid, 0)` proves a process exists, never that it is the
        # watcher that wrote the heartbeat. A recycled pid can be an editor or another agent, and
        # "stop pid N" is then advice to terminate an unrelated process — the one remedy in this
        # tool that could do damage outside the mailbox.
        print(f"  Pid {pid} EXISTS but is unverified: this cannot tell a wedged watcher from an")
        print(f"  unrelated process that reused the pid. So it cannot certify re-arming as safe OR")
        print(f"  unsafe here. Check what {pid} actually is (`ps -p {pid} -o comm=`) before acting.")
        print(f"  If it is a ccarm for this session, stopping it first avoids two watchers racing;")
        print(f"  if it is not, re-arming is safe. Either way, treat delivery as unproven until you")
        print(f"  SEE a message arrive.")
        return 1
    print(f"FRESH LEASE — {me[:8]}: heartbeat {age:.1f}s old names pid {pid}, which currently exists.")
    print("  That is a lease, NOT proof of delivery: it does not show a Monitor is attached to")
    print("  that watcher's stdout. `ccsend --ping` narrows it further — but it proves only that")
    print("  the inbox was DRAINED, and nothing this tool can run proves receipt. The only")
    print("  confirmation is you SEEING the token arrive in this session.")
    return 0


def ping(me, timeout):
    """Round-trip a token as far as ccsend can OBSERVE it: the watcher consuming it.

    ⚠️ This proves DRAINED, not DELIVERED, and the distinction is the whole point of the check.

    ccarm's loop does `mv "$INBOX" "$t"; touch "$INBOX"` BEFORE it reads and emits anything, so
    the token leaves the inbox strictly earlier than any stdout write. Waiting for it to vanish
    therefore observes the pickup, not the delivery — and in the exact state this check exists
    to detect (a watcher whose Monitor consumer is gone) the token is drained and emitted into
    nothing, which would look identical. A watcher killed between the `mv` and the read gives
    the same reading again.

    There is no acknowledgement ccsend can wait for: the last hop is Monitor turning stdout
    into a notification inside the target session, and nothing writes back. **So the final
    confirmation is the session SEEING the token**, and this function says so rather than
    claiming an exit code it cannot earn. Exit 0 means drained; it does not mean received.

    Together with `--self` it still separates the cases that matter:

        --self NO LEASE    + not drained  -> no watcher at all
        --self FRESH LEASE + not drained  -> a process holding a lease but not draining
        --self FRESH LEASE + drained + you do NOT see the token
                                          -> draining into a detached consumer: RE-ARM
    """
    if not me:
        print("CANNOT TELL — CLAUDE_CODE_SESSION_ID is unset")
        return 3
    # Fail closed, like every other send path. Without this, --ping QUEUES its token into an
    # unwatched inbox and returns NOT DRAINED — and that stale diagnostic token is delivered
    # hours later when the lane finally arms, which is the "an unwatched write looks like
    # success" behaviour this tool refuses by default everywhere else.
    if not is_armed(me):
        print(f"NO WATCHER — {me[:8]} has no live watcher, so nothing was written.")
        print("  Run `ccsend --self` for which half failed (no heartbeat, dead pid, or stale).")
        return 1
    token = f"ccping-{os.getpid()}-{int(time.time() * 1000)}"
    # Look for the ENCODED line, not the token. The inbox holds base64, so searching it for the
    # plain token matches nothing the instant it is written — the wait would fall through on its
    # first pass and report DELIVERED having observed precisely nothing. That is the same
    # "the control rewards non-delivery" defect this whole check exists to close, and it was
    # sitting in the first draft of the check itself.
    wire = base64.b64encode(f"[ccsend --ping] {token}".encode()).decode()
    inbox = inbox_for(me)
    try:
        with open(inbox, "a") as fh:
            # Same wire format the real send path uses (ccsend:523): one base64 line, which is
            # what ccarm decodes. A plain-text line would still be delivered — ccarm falls back
            # when the decode fails — but it would not be exercising the encoding this check
            # exists to prove works end to end.
            fh.write(wire + "\n")
    except OSError as e:
        print(f"CANNOT TELL — could not write to your own inbox: {e}")
        return 3
    # The watcher CONSUMES the inbox: it moves the file aside, so the token vanishing is the
    # observable proof it was picked up for delivery. Waiting for it to disappear is therefore
    # a real signal, not a timeout dressed up as one.
    deadline = time.time() + timeout
    while time.time() < deadline:
        try:
            if wire not in open(inbox).read():
                print(f"DRAINED — {token} was picked up by the watcher within "
                      f"{timeout - (deadline - time.time()):.1f}s.")
                print("  NOT a delivery receipt. ccarm empties the inbox BEFORE it emits anything,")
                print("  so this observes the pickup only, and a watcher whose Monitor is detached")
                print("  drains it into nothing and looks identical here.")
                print(f"  CONFIRM IT YOURSELF: you should now SEE the token {token} in this session.")
                print("  If you do not, the watcher is draining into a detached consumer — RE-ARM.")
                return 0
        except OSError:
            pass
        time.sleep(0.2)
    print(f"NOT DRAINED — {token} still sits in your inbox after {timeout:.0f}s.")
    print("  Nothing is consuming it. Ambiguous alone; run `ccsend --self` to tell 'no watcher'")
    print("  from 'watcher holds a lease but is not draining'.")
    return 1


def heartbeat_sids():
    """Every SID with a heartbeat file, whether or not it has a transcript."""
    try:
        return {f[: -len(".armed")] for f in os.listdir(MAILBOX) if f.endswith(".armed")}
    except OSError:
        return set()


def inventory(all_s, caller=None):
    """The listing/resolution universe: transcripts UNION heartbeats UNION the caller.

    `sessions()` alone is not it, and the gap is not cosmetic. It enumerates
    `ROOT/*/*.jsonl` and skips any transcript under 2000 bytes, so a lane that armed before
    its transcript grew — or whose transcript lives elsewhere — is ABSENT while its watcher
    is live and draining. Measured 2026-08-06: `--list` printed 25 of 199 sessions and 13 of
    34 armed lanes were invisible.

    The caller is a third source because it belongs in the listing precisely when it has
    NEITHER of the other two: a session whose watcher exited cleanly has no heartbeat, and a
    new one may have no qualifying transcript. That is the dead-inbox state most in need of a
    row, and it is the one both earlier drafts dropped.

    Placeholder rows carry the same 6-tuple shape so every consumer can stay uniform.
    """
    known = {s[0] for s in all_s}
    extra = [sid for sid in sorted(heartbeat_sids() | ({caller} if caller else set()))
             if sid not in known]
    return list(all_s) + [(sid, "(no transcript)", "", 0.0, False, "") for sid in extra]


def resolve(needle, all_s):
    hits = [s for s in all_s if s[0].startswith(needle)]
    if not hits:
        n = needle.lower()
        # Match the DISPLAY name, the cwd, and the superseded ai-title. Renaming a session must not
        # make it unreachable by the name it used to have: an older message, note or handover refers
        # to it by whatever it was called then, and "no session matches" reads as "that lane is gone"
        # rather than "it was renamed".
        hits = [s for s in all_s
                if n in s[1].lower() or n in s[2].lower()
                or (len(s) > 5 and s[5] and n in s[5].lower())]
    if not hits:
        sys.exit(f"no session matches {needle!r} — run `ccsend --list`")
    if len({h[0] for h in hits}) > 1:
        print("ambiguous — matches:", file=sys.stderr)
        for h in hits:
            print(f"  {h[0][:8]}  {h[1]}", file=sys.stderr)
        sys.exit(1)
    return hits[0]


def main():
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("target", nargs="?")
    p.add_argument("message", nargs="*")
    p.add_argument("--file", help="read the body from a file, or '-' for stdin "
                                  "(use a quoted heredoc for anything with backticks)")
    p.add_argument("--from", dest="sender", default=os.environ.get("CCSEND_FROM", ""),
                   help="label recorded as the sender")
    p.add_argument("--list", action="store_true",
                   # NOTE: never rendered — add_help=False at the ArgumentParser and the help
                   # branch prints __doc__, so no argparse help formatter ever runs. Kept
                   # correct anyway: the day someone enables add_help it becomes user-facing.
                   help="show which sessions are armed — armed is not a promise of receipt")
    p.add_argument("--self", dest="self_check", action="store_true",
                   help="report THIS session's own watcher lease (0 fresh, 1 none, 3 cannot tell)")
    p.add_argument("--ping", action="store_true",
                   help="send this session a token and wait for the watcher to drain it. Proves the "
                        "inbox was DRAINED, NOT that anything was received")
    p.add_argument("--timeout", type=float, default=8.0, help="seconds --ping waits")
    p.add_argument("--arm", action="store_true", help="print the Monitor command for a target")
    p.add_argument("--force", action="store_true", help="queue even if no watcher is armed")
    p.add_argument("-h", "--help", action="store_true")
    # parse_known_args, not parse_args: argparse cannot gather a `nargs="*"`
    # positional that appears AFTER an option, and `ccsend <id> --from x "msg"`
    # is the natural way to type this. Leftovers are message text.
    # Honour the conventional `--` separator BEFORE parsing. Everything after it is message text,
    # verbatim, whatever it starts with. Without it there is no way to send a body that begins with
    # a dash, and the failure is not uniform — measured on this build:
    #   "--blocked pending review"  delivered      (argparse assigned it to the positional)
    #   "--unknownflag"             rejected, 2
    #   "--force"                   consumed AS the flag -> "empty message"
    #   "--list"                    consumed AS the flag -> it LISTED instead of sending
    # That last one is the reason this matters beyond ergonomics: a message body equal to a known
    # flag silently performs a DIFFERENT ACTION and reports success.
    argv = sys.argv[1:]
    forced_body = []
    if "--" in argv:
        i = argv.index("--")
        argv, forced_body = argv[:i], argv[i + 1:]
    a, extra = p.parse_known_args(argv)
    # REFUSE an unrecognised flag. `parse_known_args` hands them back in `extra`, and this line
    # used to DROP them — so `ccsend --sef` (a typo for --self) printed usage and exited 0, and
    # `ccsend --self; [ $? -eq 0 ] && healthy` reported HEALTHY for a flag that does not exist.
    # A health check whose typo is indistinguishable from a pass is this cluster's own defect:
    # a mitigation that is present and protects nobody. It also converts to a silent no-op the day
    # anyone renames the flag, which is precisely how the instruction telling lanes to run it would
    # rot. Found by `01f19563` while writing that instruction.
    #
    # Exit 2 keeps it out of the diagnostic's 0/1/3 vocabulary: "you asked for something that does
    # not exist" is a different answer from "your inbox is fine / broken / unmeasurable".
    unknown = [x for x in extra if x.startswith("-") and x != "-"]
    if unknown:
        print(f"ccsend: unrecognised option {unknown[0]!r}", file=sys.stderr)
        print("Run `ccsend` with no arguments for usage. For message text that begins with a dash, "
              "use `--file -` and a quoted heredoc.", file=sys.stderr)
        return 2
    a.message = list(a.message) + list(extra) + forced_body
    # `--self` and `--ping` take no target and are not `--list`, so they fall into this branch
    # unless named here. Measured: without them, every one of their controls printed the
    # docstring and exited 0 — including the two that MUST fail, which is the only reason it
    # was caught rather than recorded as six passes.
    if a.help or (not a.target and not a.list and not a.self_check and not a.ping):
        print(__doc__)
        return

    me = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    # Dispatch the diagnostics BEFORE scanning transcripts. Neither uses session metadata, and
    # `sessions()` can raise: its `os.path.getmtime(f)` sits outside the OSError handler, so a
    # transcript removed mid-scan produces a TRACEBACK instead of one of the three verdicts —
    # in the check whose whole contract is that it always answers 0, 1 or 3.
    if a.self_check:
        return self_check(me)
    if a.ping:
        return ping(me, a.timeout)

    all_s = sessions()
    # ONE inventory for listing AND resolution. Two would let --list advertise a lane that
    # `ccsend <that-id>` then refuses with "no session matches" — an advertised receiver you
    # cannot send to is worse than an omitted one, because it converts a silent gap into a
    # confident wrong answer.
    all_s = inventory(all_s, caller=me or None)

    if a.list:
        # Deliberately carries NO row token: `unarmed` contains `armed`, so a header
        # mentioning either is indistinguishable from a data row to `grep -c armed`
        # (it over-counted by 2 — this line and the footer). TOR-474.
        print("# \U0001f4ec = a fresh lease AT THIS SNAPSHOT, not receipt. Sends re-check;")
        print("# without a fresh lease then, only --force queues.\n")
        # Probe each SID EXACTLY ONCE. Calling is_armed twice makes the two partitions
        # non-complementary: a watcher that dies between the passes lands in both (printed
        # twice), and one that starts between them lands in neither (omitted while armed) —
        # in a tool whose job is to produce one coherent watcher-lease snapshot. Watcher
        # death and restart are
        # routine here, so this is an ordinary interleaving, not a rare one.
        live = {s[0]: is_armed(s[0]) for s in all_s}
        armed = [s for s in all_s if live[s[0]]]
        rest = [s for s in all_s if not live[s[0]]]
        mine = [s for s in rest if me and s[0] == me]
        # NEVER cap an armed row: those are the rows that gate delivery, and the old
        # `all_s[:25]` hid 13 of 34 of them. Cap only the idle tail — and pin the caller's own
        # row outside that cap, since it is capped away exactly when it matters most.
        capped = [s for s in rest if s not in mine][:25]
        omitted = len(rest) - len(mine) - len(capped)
        for sid, title, cwd, mt, *_ in armed + mine + capped:
            idle = "   ?" if not mt else f"{int((time.time() - mt) / 60):>4}"
            mark = "📬 armed  " if live[sid] else "   unarmed"
            you = "  <- you" if me and sid == me else ""
            print(f"{mark} {sid[:8]}  {idle}m ago  {title[:52]}{you}")
        if omitted:
            # Say what was dropped. Silent truncation reads as "that is everyone".
            # No row token here either — see the header comment above. TOR-474.
            print(f"\n… {omitted} older session(s) with no watcher not shown "
                  f"(\U0001f4ec rows are never hidden)")
        return

    sid, title, _cwd, _mt, *_ = resolve(a.target, all_s)
    inbox = inbox_for(sid)

    if a.arm:
        print(f"# {sid[:8]} ({title}) can be armed via /arm-inbox — arming is not receipt,")
        print("# or calls Monitor with persistent: true and this command:\n")
        print(f"{CCARM} {sid}")
        return

    # `--file -` reads stdin, which makes the quoted heredoc the cheapest safe way
    # to send anything technical:
    #
    #     ccsend <id> --file - <<'EOF'
    #     ... backticks, $vars and quotes all survive verbatim ...
    #     EOF
    #
    # That matters more than it looks. A message passed as a shell argument goes
    # through the shell first, so `code` is COMMAND SUBSTITUTION — the word is
    # replaced by the output of running it, usually empty. Measured 2026-07-30: a
    # handover written with backticked identifiers arrived with gaps where every
    # identifier had been, and ccsend still reported a clean delivery, because by
    # the time it sees argv the damage is already done and is undetectable here.
    if a.file == "-":
        body = sys.stdin.read()
    elif a.file:
        body = open(a.file).read()
    else:
        body = " ".join(a.message)
    if not body.strip():
        sys.exit("ccsend: empty message")

    armed = is_armed(sid)
    if not armed and not a.force:
        sys.exit(
            f"✗ not delivered — {sid[:8]} ({title}) has no inbox watcher.\n"
            f"  Nothing is listening, so this would sit unread and look like success.\n"
            f"  Have it arm one:  ccsend {sid[:8]} --arm\n"
            f"  Or queue anyway:  --force"
        )

    # Identify the sender so the recipient can reply without having to work out
    # who sent it. A message that can't be answered is a notification, not a
    # conversation — and the harness exports the caller's own id for free.
    me = os.environ.get("CLAUDE_CODE_SESSION_ID", "")
    if a.sender:
        who = a.sender
    elif me:
        mine = next((s for s in all_s if s[0] == me), None)
        who = f"{mine[1]} ({me[:8]})" if mine else me[:8]
    else:
        who = "an unidentified sender"

    os.makedirs(MAILBOX, exist_ok=True)
    body = body.rstrip()
    path = spill(sid, who, body)

    header = f"[message from {who}]"
    if me:
        header += f"\n[reply with: ccsend {me[:8]} \"...\"]"
    # The path goes to the RECIPIENT, on every message, not just previews. Without
    # it `spill`'s whole re-readability claim is unreachable: the sender's stdout
    # names the file, and the sender is the one party who does not need it. A short
    # message that scrolls away or is compacted out is otherwise simply gone.
    header += f"\n[full text: {path}]"

    wrapped = wrap(body)
    if len(header) + len(wrapped) + 2 <= INLINE_BUDGET:
        payload = f"{header}\n{wrapped}"
        mode = "inline"
    else:
        # Cut on a line boundary so the preview never ends mid-sentence — the
        # exact ambiguity the cap created. The banner comes FIRST: a recipient
        # who reads only the opening lines still learns there is more, whereas a
        # footer note is the part most likely to be scrolled past.
        banner = (
            f"[PREVIEW — this message is {len(body)} chars and the notification channel "
            f"truncates near {EVENT_CAP}. Read the full text at the path above BEFORE "
            f"acting on it — what follows stops early.]"
        )
        room = INLINE_BUDGET - len(header) - len(banner) - 8
        head, total = [], 0
        for line in wrapped.split("\n"):
            if total + len(line) + 1 > room:
                break
            head.append(line)
            total += len(line) + 1
        payload = f"{header}\n{banner}\n\n" + "\n".join(head) + "\n[…]"
        mode = f"preview + file ({len(body)} chars)"

    with open(inbox, "a") as fh:
        fh.write(base64.b64encode(payload.encode()).decode() + "\n")

    where = f"{sid[:8]} ({title})"
    if armed:
        # ACCEPTED, not delivered: this proves the message was written to the inbox of a
        # session holding a fresh lease. It does NOT prove anyone saw it — a detached
        # watcher drains the inbox to nobody (TOR-425, detached-watcher drain).
        # Describe ONLY what was sampled. The lease was read at preflight (`is_armed` above);
        # the append happens later, so the watcher can die in between. "a fresh lease" asserts a
        # present-tense fact this code never established. TOR-474.
        print(f"\u2713 accepted for {where} — lease was fresh at preflight; NOT proof it was seen [{mode}]")
    else:
        # NOT CONFIRMED, never "no lease": `is_armed` collapses every exception to False, so
        # this branch covers absent, stale AND unreadable alike. A live draining watcher whose
        # heartbeat we merely failed to read lands here, and telling the sender there was no
        # lease states as fact something the probe did not establish.
        print(f"\u23f8 queued for {where} — fresh lease NOT CONFIRMED at preflight; "
              f"pickup unproven [{mode}]")
    print(f"  full text: {path}")


if __name__ == "__main__":
    try:
        # main() returns an exit code for the diagnostic paths (--self, --ping) and None for
        # the rest. Without propagating it, a three-state check collapses to "always 0" — the
        # verdict would print correctly and every caller gating on the status would proceed.
        sys.exit(main() or 0)
    except BrokenPipeError:
        pass
